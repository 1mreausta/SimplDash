# --- Süsteem ---
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM (kaadripuhvrid) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_FONT_MONTSERRAT_14=y

# --- CAN (TWAI) ISR IRAM-is, et välkmälu kirjutamine ei segaks ---
CONFIG_TWAI_ISR_CACHE_SAFE=y
# RACE 2 vaate ümmargune kuma (radiaalne gradient)
CONFIG_LV_GRADIENT_MAX_STOPS=4
CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y

# --- SD-kaart: pikad failinimed (20261119_174512.csv) ---
CONFIG_FATFS_LFN_HEAP=y
